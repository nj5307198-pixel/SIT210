from gpiozero import PWMLED
import tkinter as tk

# LED
led = PWMLED(27)

# Change LED brightness
def change_brightness(value):
    led.value = float(value) / 100

# GUI
window = tk.Tk()
window.title("Living Room Light")
window.geometry("500x300")

title = tk.Label(
    window,
    text="Living Room Light",
    font=("Arial", 22)
)
title.pack(pady=20)

slider = tk.Scale(
    window,
    from_=0,
    to=100,
    orient=tk.HORIZONTAL,
    length=350,
    label="Brightness (%)",
    command=change_brightness
)
slider.set(50)
slider.pack(pady=20)

# Close program
def close_program():
    led.off()
    window.destroy()

window.protocol("WM_DELETE_WINDOW", close_program)

window.mainloop()
