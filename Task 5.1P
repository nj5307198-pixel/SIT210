from gpiozero import LED
import tkinter as tk

# LED Setup
# Connect each LED to its corresponding GPIO pin
living = LED(17)      # Living room LED on GPIO 17
bathroom = LED(27)    # Bathroom LED on GPIO 27
closet = LED(22)      # Closet LED on GPIO 22

# Function to control the LEDs
# Turns OFF all LEDs first, then turns ON only the selected room's LED
def select_room():
    # Get the selected room
    choice = room.get()

    # Turn OFF all LEDs
    living.off()
    bathroom.off()
    closet.off()

    # Turn ON the selected room's LED
    if choice == "Living Room":
        living.on()
    elif choice == "Bathroom":
        bathroom.on()
    elif choice == "Closet":
        closet.on()

# Create the main GUI window
window = tk.Tk()
window.title("Smart Home Lights")
window.geometry("350x250")

# Variable to store the selected room
room = tk.StringVar()

# Heading label
title = tk.Label(window, text="Smart Home Lights")
title.pack(pady=15)

# Living Room radio button
tk.Radiobutton(
    window,
    text="Living Room",
    variable=room,
    value="Living Room",
    command=select_room
).pack()

# Bathroom radio button
tk.Radiobutton(
    window,
    text="Bathroom",
    variable=room,
    value="Bathroom",
    command=select_room
).pack()

# Closet radio button
tk.Radiobutton(
    window,
    text="Closet",
    variable=room,
    value="Closet",
    command=select_room
).pack()

# Exit button to close the application
tk.Button(
    window,
    text="Exit",
    command=window.destroy
).pack(pady=20)

# Start the GUI event loop
window.mainloop()
